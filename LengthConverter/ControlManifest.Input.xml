<?xml version="1.0" encoding="utf-8" ?>
<manifest>
  <control namespace="LengthConverterNamespace" constructor="LengthConverter" version="0.0.2" display-name-key="LengthConverter" description-key="LengthConverter description" control-type="standard" >
    <!--external-service-usage node declares whether this 3rd party PCF control is using external service or not, if yes, this control will be considered as premium and please also add the external domain it is using.
    If it is not using any external service, please set the enabled="false" and DO NOT add any domain below. The "enabled" will be false by default.
    Example1:
      <external-service-usage enabled="true">
        <domain>www.Microsoft.com</domain>
      </external-service-usage>
    Example2:
      <external-service-usage enabled="false">
      </external-service-usage>
    -->
    <external-service-usage enabled="false">
      <!--UNCOMMENT TO ADD EXTERNAL DOMAINS
      <domain></domain>
      <domain></domain>
      -->
    </external-service-usage>
    <!-- property node identifies a specific, configurable piece of data that the control expects from CDS -->
    <type-group name="numbers">
      <type>Whole.None</type>
      <type>Currency</type>
      <type>FP</type>
      <type>Decimal</type>
    </type-group>
    <property name="controlValue" display-name-key="Control Value" description-key="The value of the field" of-type-group="numbers" usage="bound" required="true" />
    <property name="baseUnit" display-name-key="Base Unit" description-key="The unit of the value in the database" of-type="Enum" usage="input" required="true" default-value="m">
      <value name="m" display-name-key="Meters">m</value>
      <value name="cm" display-name-key="Centimeters">cm</value>
      <value name="mm" display-name-key="Millimeters">mm</value>
      <value name="km" display-name-key="Kilometers">km</value>
      <value name="ft" display-name-key="Feet">ft</value>
      <value name="in" display-name-key="Inches">in</value>
      <value name="yd" display-name-key="Yards">yd</value>
      <value name="mi" display-name-key="Miles">mi</value>
    </property>
    <resources>
      <code path="index.ts" order="1"/>
      <!-- <platform-library name="React" version="16.14.0" /> -->
      <!-- <platform-library name="Fluent" version="9.68.0" /> -->
